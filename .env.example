# ===========================================
# GameFeatures - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_review?schema=public"

# Redis (for caching and job queue)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
# IMPORTANT: Change these to strong random strings in production!
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# OAuth - Google (optional)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - Twitch (optional)
# Get credentials at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# RAWG API (optional - for external game search)
# Get free API key at: https://rawg.io/apidocs
RAWG_API_KEY=""
# Max time for one RAWG call before the API answers 504 (default 5000)
RAWG_TIMEOUT_MS=5000

# Firebase Cloud Messaging (optional - for push notifications)
# Get credentials from Firebase Console
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# App URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# Rate limiting (per client IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Stricter limit for login/register/refresh, per AUTH_THROTTLE_TTL_MS (default 60000)
AUTH_THROTTLE_LIMIT=10
# Number of reverse proxies in front of the API whose X-Forwarded-For is trusted
# (0 locally; set for the deployed chain, see docs/DEPLOY.md)
TRUST_PROXY_HOPS=0

# Seed (pnpm db:seed)
# Password for the demo_gamer and demo_dev accounts (public on purpose; default "try-the-demo")
SEED_DEMO_PASSWORD="try-the-demo"
# Optional admin account: created only when both are set (password >= 16 chars in production)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
