# Where the API server runs. Next.js proxies /api/v1/* there (next.config.js rewrites), so the
# browser talks to one origin and the refresh cookie works. Read at build time on Vercel.
API_ORIGIN=http://localhost:3001

# Socket.IO connects to the API server directly (rewrites don't proxy WebSockets).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional override for the REST base URL (default: the relative /api/v1 through the rewrite).
# Setting it to the API's own URL bypasses the proxy, which breaks the refresh cookie in production.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Demo mode (the public deployment): cold-start banner, one-click demo logins, footer note.
NEXT_PUBLIC_DEMO_MODE=false
# Password of the seeded demo_gamer / demo_dev accounts (public on purpose; matches SEED_DEMO_PASSWORD).
NEXT_PUBLIC_DEMO_PASSWORD=try-the-demo
# OAuth buttons to show on the login page, comma-separated (google,twitch). When unset: none in
# demo mode, both otherwise. Leave empty in the demo: no OAuth credentials are configured there.
# NEXT_PUBLIC_OAUTH_PROVIDERS=google,twitch
