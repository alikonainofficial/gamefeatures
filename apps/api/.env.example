# Database
# Runtime connection. On Neon, use the *pooled* connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_review?schema=public"
# Used by prisma migrate (the Docker image runs `migrate deploy` on start). On Neon, use the
# *direct* (unpooled) string; locally it's the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/game_review?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - Twitch
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# RAWG API
RAWG_API_KEY=""
# Max time for one RAWG call before the API answers 504 (default 5000)
RAWG_TIMEOUT_MS=5000

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# App URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Port
PORT=3001

# Node environment
NODE_ENV="development"

# Rate limiting (per client IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Stricter limit for login/register/refresh, per AUTH_THROTTLE_TTL_MS (default 60000)
AUTH_THROTTLE_LIMIT=10
# Number of reverse proxies in front of the API whose X-Forwarded-For is trusted
# (0 locally; set for the deployed chain, see docs/DEPLOY.md)
TRUST_PROXY_HOPS=0
# Log each request's resolved client IP and X-Forwarded-For, to check TRUST_PROXY_HOPS
# after a deploy (docs/DEPLOY.md). Leave off otherwise.
LOG_CLIENT_IP=false
