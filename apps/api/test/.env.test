# Defaults for the e2e tests (committed on purpose: no real secrets here).
# Variables already set in the environment (e.g. by CI) win over these.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game_review_test?schema=public
# DB index 1 keeps test keys away from the dev data in index 0.
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=test-only-jwt-secret
JWT_REFRESH_SECRET=test-only-refresh-secret
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
